rules_version = '2';

// Открытый доступ: без авторизации, кто угодно с адресом сайта может
// читать и писать данные отгрузки. Осознанный выбор ради простоты —
// см. предупреждение в README про риски и как перейти на роли позже.
service cloud.firestore {
  match /databases/{database}/documents {
    match /shipments/{date} {
      allow read, write: if true;
    }
  }
}
